# Server-only. Used to mint short-lived realtime voice credentials.
# The browser never receives this value.
OPENAI_API_KEY=

# Optional. Defaults to gpt-realtime / marin.
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# Used for absolute metadata URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
